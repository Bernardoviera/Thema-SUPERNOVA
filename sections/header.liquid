<header class="site-header" role="banner">
  <div class="header-wrapper">
    <!-- Logo -->
    {%- assign logo_height = section.settings.logo_height | default: 40 -%}
    {%- assign logo_height_mobile = section.settings.logo_height_mobile | default: 32 -%}
    {%- assign logo_render_height = logo_height -%}
    {%- if logo_height_mobile > logo_height -%}{%- assign logo_render_height = logo_height_mobile -%}{%- endif -%}
    {%- assign logo_2x = logo_render_height | times: 2 -%}
    {%- assign has_inverse = false -%}
    {%- if section.settings.logo_inverse != blank -%}{%- assign has_inverse = true -%}{%- endif -%}
    <div class="header__logo{% if has_inverse %} header__logo--has-inverse{% endif %}" style="--logo-height: {{ logo_height }}px; --logo-height-mobile: {{ logo_height_mobile }}px;">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: height: logo_2x
            | image_tag: class: 'header__logo-image header__logo-image--default', alt: shop.name, loading: 'eager'
          }}
          {%- if has_inverse -%}
            {{
              section.settings.logo_inverse
              | image_url: height: logo_2x
              | image_tag: class: 'header__logo-image header__logo-image--inverse', alt: shop.name, loading: 'eager'
            }}
          {%- endif -%}
        {%- else -%}
          <span class="header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="header__nav" role="navigation" aria-label="Main menu">
      {%- for link in section.settings.menu.links -%}
        <li class="header__nav-item">
          <a href="{{ link.url }}">{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <ul class="dropdown-menu">
              {%- for child_link in link.links -%}
                <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </nav>

    <!-- Actions -->
    <div class="header__actions">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="header__icon-btn" aria-label="{{ 'general.search.search' | t }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__icon-btn" aria-label="{{ 'customer.account.title' | t }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
      {%- endif -%}

      <button class="header__icon-btn" data-open-cart aria-label="{{ 'sections.cart.title' | t }}" style="position:relative">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count-bubble" aria-label="{{ 'sections.cart.cart_count' | t: count: cart.item_count }}">
            {{ cart.item_count }}
          </span>
        {%- else -%}
          <span class="cart-count-bubble" style="display:none" aria-hidden="true">0</span>
        {%- endif -%}
      </button>

      <button class="header__hamburger" aria-label="Menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation -->
<nav class="mobile-nav" aria-label="Mobile menu" aria-hidden="true">
  <button class="mobile-nav__close" aria-label="Close menu">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <ul class="mobile-nav__list">
    {%- for link in section.settings.menu.links -%}
      <li class="mobile-nav__item">
        <a href="{{ link.url }}">{{ link.title }}</a>
      </li>
    {%- endfor -%}
  </ul>
</nav>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (home / fundo claro)"
    },
    {
      "type": "image_picker",
      "id": "logo_inverse",
      "label": "Logo — cabeçalho escuro (páginas internas / ao rolar)",
      "info": "Opcional. Use uma versão branca/clara. Se vazio, usa a logo principal em todo lugar."
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px",
      "label": "Logo / nome — tamanho (desktop)",
      "info": "Funciona tanto para a imagem do logo quanto para o nome em texto."
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 16,
      "max": 80,
      "step": 2,
      "default": 32,
      "unit": "px",
      "label": "Logo / nome — tamanho (celular)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "Show search"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "default": true,
      "label": "Show account"
    }
  ]
}
{% endschema %}
