<section class="section">
  <div class="page-width">
    <div class="product">
      <!-- Gallery -->
      <div class="product-media-gallery">
        <div class="product-media__main">
          {%- if product.featured_image -%}
            {{
              product.featured_image
              | image_url: width: 900
              | image_tag: loading: 'eager', width: 900, alt: product.title, id: 'product-main-image'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-media__thumbs-wrap">
            <div class="product-media__thumbnails">
              {%- for image in product.images limit: 25 -%}
                <div class="product-media__thumb{% if forloop.first %} is-active{% endif %}">
                  {{
                    image
                    | image_url: width: 300
                    | image_tag: loading: 'lazy', width: 300, alt: product.title
                  }}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Info -->
      <div class="product-info">
        {%- if section.settings.drop_badge != blank -%}
          <div class="product-info__badge">{{ section.settings.drop_badge }}</div>
        {%- endif -%}

        {%- if product.vendor != blank -%}
          <div class="product-info__vendor">{{ product.vendor }}</div>
        {%- endif -%}

        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__price">
          {%- render 'price', product: product -%}
        </div>

        {%- form 'product', product, id: 'product-form', class: 'product-form' -%}
          <script type="application/json" data-product-variants>{{ product.variants | json }}</script>
          <script type="application/json" data-variant-images>{ {% for variant in product.variants %}{% assign vimg = variant.featured_media.preview_image | default: variant.featured_image %}"{{ variant.id }}": {% if vimg %}{{ vimg | image_url: width: 1200 | json }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}{% endfor %} }</script>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <!-- Variant options -->
          {%- unless product.has_only_default_variant -%}
            <div class="product-form__variants">
              {%- for option in product.options_with_values -%}
                {%- assign is_color = false -%}
                {%- if option.name == 'Cor' or option.name == 'Color' or option.name == 'Colour' -%}{%- assign is_color = true -%}{%- endif -%}
                {%- assign opt_prop = 'option' | append: forloop.index -%}
                <div class="product-form__option">
                  <label class="variant-label">
                    {{ option.name }}
                    <span id="selected-{{ option.name | handleize }}-{{ section.id }}">{{ option.selected_value }}</span>
                  </label>
                  <div class="variant-options{% if is_color %} variant-options--color{% endif %}">
                    {%- for value in option.values -%}
                      {%- if is_color -%}
                        {%- assign cparts = value | split: '/' -%}
                        {%- if cparts.size > 1 -%}
                          {%- assign c1 = cparts[0] | strip | downcase -%}
                          {%- assign c2 = cparts[1] | strip | downcase -%}
                          {%- capture swatch_style -%}background:linear-gradient(135deg,{{ c1 }} 0 50%,{{ c2 }} 50% 100%);{%- endcapture -%}
                        {%- else -%}
                          {%- capture swatch_style -%}background-color:{{ value | downcase }};{%- endcapture -%}
                        {%- endif -%}
                      {%- endif -%}
                      <button
                        type="button"
                        class="variant-opt{% if option.selected_value == value %} is-selected{% endif %}{% if is_color %} variant-opt--color{% endif %}"
                        data-option="{{ opt_prop }}"
                        data-value="{{ value | escape }}"
                        {% if is_color %}
                          style="{{ swatch_style }}"
                          title="{{ value }}"
                          aria-label="{{ value }}"
                        {% endif %}
                      >
                        {%- unless is_color -%}{{ value }}{%- endunless -%}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          {%- if section.settings.show_size_guide and section.settings.size_guide_content != blank -%}
            <button type="button" class="product-form__size-guide" data-size-guide-open aria-haspopup="dialog">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7l4-4 14 14-4 4z"/><path d="M7 11l2-2M11 15l2-2M9 13l2-2"/></svg>
              {{ section.settings.size_guide_label | default: 'Guia de tamanhos' }}
            </button>
          {%- endif -%}

          <!-- Quantity -->
          <div class="product-form__quantity">
            <div class="quantity-selector">
              <button type="button" class="quantity-btn" data-action="decrease">−</button>
              <input class="quantity-input" type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.item_quantity' | t }}">
              <button type="button" class="quantity-btn" data-action="increase">+</button>
            </div>
          </div>

          <!-- Submit -->
          <div class="product-form__submit">
            <button
              type="submit"
              name="add"
              class="btn btn--primary btn--full"
              data-add-to-cart
              {%- unless product.selected_or_first_available_variant.available -%}disabled{%- endunless -%}
            >
              {%- if product.selected_or_first_available_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>

          {%- if section.settings.show_reassurance -%}
            <ul class="product-reassurance">
              {%- for i in (1..4) -%}
                {%- assign tkey = 'reassurance_' | append: i | append: '_text' -%}
                {%- assign ikey = 'reassurance_' | append: i | append: '_icon' -%}
                {%- assign rtext = section.settings[tkey] -%}
                {%- if rtext != blank -%}
                  <li class="product-reassurance__item">
                    {%- render 'sn-icon', icon: section.settings[ikey] -%}
                    <span>{{ rtext }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.show_accordions -%}
          <div class="product-accordions">
            {%- for i in (1..4) -%}
              {%- assign tkey = 'accordion_' | append: i | append: '_title' -%}
              {%- assign ckey = 'accordion_' | append: i | append: '_content' -%}
              {%- assign ikey = 'accordion_' | append: i | append: '_icon' -%}
              {%- assign atitle = section.settings[tkey] -%}
              {%- assign acontent = section.settings[ckey] -%}
              {%- if atitle != blank and acontent != blank -%}
                <details class="product-accordion"{% if forloop.first and section.settings.accordion_first_open %} open{% endif %}>
                  <summary class="product-accordion__head">
                    <span class="product-accordion__label">{%- render 'sn-icon', icon: section.settings[ikey] -%}{{ atitle }}</span>
                    <svg class="product-accordion__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </summary>
                  <div class="product-accordion__body">{{ acontent }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if product.description != blank -%}
          <div class="product-info__description">{{ product.description }}</div>
        {%- endif -%}

        <!-- Meta info -->
        <div class="product-info__meta">
          {%- if product.sku != blank -%}
            <p>SKU: <span>{{ product.selected_or_first_available_variant.sku }}</span></p>
          {%- endif -%}
          {%- if product.type != blank -%}
            <p>{{ 'products.product.category' | t }}: <span>{{ product.type }}</span></p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <!-- Sticky add-to-cart bar (slides up once the main button scrolls away) -->
  <div class="product-sticky-bar" data-sticky-bar aria-hidden="true">
    <div class="page-width product-sticky-bar__inner">
      <div class="product-sticky-bar__info">
        {%- if product.featured_image -%}
          <img class="product-sticky-bar__thumb" src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy" width="60" height="60">
        {%- endif -%}
        <div class="product-sticky-bar__text">
          <span class="product-sticky-bar__title">{{ product.title }}</span>
          <span class="product-sticky-bar__price" data-sticky-price>{%- render 'price', product: product -%}</span>
        </div>
      </div>
      <div class="product-sticky-bar__actions">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <select class="product-sticky-bar__select" data-sticky-option="option{{ forloop.index }}" aria-label="{{ option.name | escape }}">
              {%- for value in option.values -%}
                <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
              {%- endfor -%}
            </select>
          {%- endfor -%}
        {%- endunless -%}
        <div class="quantity-selector product-sticky-bar__qty">
          <button type="button" class="quantity-btn" data-action="decrease">−</button>
          <input class="quantity-input" type="number" value="1" min="1" aria-label="Quantity" data-sticky-qty style="width:4rem">
          <button type="button" class="quantity-btn" data-action="increase">+</button>
        </div>
        <button type="button" class="btn btn--primary product-sticky-bar__add" data-sticky-add>Add to cart</button>
      </div>
    </div>
  </div>

  {%- if section.settings.show_size_guide and section.settings.size_guide_content != blank -%}
    <div class="size-guide-modal" data-size-guide-modal aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ section.settings.size_guide_label | default: 'Guia de tamanhos' }}">
      <div class="size-guide-modal__overlay" data-size-guide-close></div>
      <div class="size-guide-modal__box">
        <button type="button" class="size-guide-modal__close" data-size-guide-close aria-label="Fechar">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <h2 class="size-guide-modal__title">{{ section.settings.size_guide_label | default: 'Guia de tamanhos' }}</h2>
        <div class="size-guide-modal__content">{{ section.settings.size_guide_content }}</div>
      </div>
    </div>
  {%- endif -%}
</section>

