<section class="section">
  <div class="page-width">
    <div class="product">
      <!-- Gallery -->
      <div class="product-media-gallery">
        <div class="product-media__main">
          {%- if product.featured_image -%}
            {{
              product.featured_image
              | image_url: width: 900
              | image_tag: loading: 'eager', width: 900, alt: product.title, id: 'product-main-image'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-media__thumbs-wrap">
            <div class="product-media__thumbnails">
              {%- for image in product.images limit: 25 -%}
                <div class="product-media__thumb{% if forloop.first %} is-active{% endif %}">
                  {{
                    image
                    | image_url: width: 300
                    | image_tag: loading: 'lazy', width: 300, alt: product.title
                  }}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Info -->
      <div class="product-info">
        {%- if section.settings.drop_badge != blank -%}
          <div class="product-info__badge">{{ section.settings.drop_badge }}</div>
        {%- endif -%}

        {%- if product.vendor != blank -%}
          <div class="product-info__vendor">{{ product.vendor }}</div>
        {%- endif -%}

        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__price">
          {%- render 'price', product: product -%}
        </div>

        {%- form 'product', product, id: 'product-form', class: 'product-form' -%}
          <script type="application/json" data-product-variants>{{ product.variants | json }}</script>
          <script type="application/json" data-variant-images>{ {% for variant in product.variants %}{% assign vimg = variant.featured_media.preview_image | default: variant.featured_image %}"{{ variant.id }}": {% if vimg %}{{ vimg | image_url: width: 1200 | json }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}{% endfor %} }</script>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <!-- Variant options -->
          {%- unless product.has_only_default_variant -%}
            <div class="product-form__variants">
              {%- for option in product.options_with_values -%}
                <div class="product-form__option">
                  <label class="variant-label">
                    {{ option.name }}
                    <span id="selected-{{ option.name | handleize }}-{{ section.id }}">{{ option.selected_value }}</span>
                  </label>
                  <div class="variant-options{% if option.name == 'Cor' or option.name == 'Color' or option.name == 'Colour' %} variant-options--color{% endif %}">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="variant-opt{% if option.selected_value == value %} is-selected{% endif %}{% if option.name == 'Cor' or option.name == 'Color' %} variant-opt--color{% endif %}"
                        data-option="option{{ forloop.parentloop.index }}"
                        data-value="{{ value | escape }}"
                        {% if option.name == 'Cor' or option.name == 'Color' %}
                          style="background-color:{{ value | downcase }};"
                          title="{{ value }}"
                        {% endif %}
                      >
                        {%- unless option.name == 'Cor' or option.name == 'Color' -%}{{ value }}{%- endunless -%}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          {%- if section.settings.show_size_guide and section.settings.size_guide_content != blank -%}
            <button type="button" class="product-form__size-guide" data-size-guide-open aria-haspopup="dialog">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7l4-4 14 14-4 4z"/><path d="M7 11l2-2M11 15l2-2M9 13l2-2"/></svg>
              {{ section.settings.size_guide_label | default: 'Guia de tamanhos' }}
            </button>
          {%- endif -%}

          <!-- Quantity -->
          <div class="product-form__quantity">
            <div class="quantity-selector">
              <button type="button" class="quantity-btn" data-action="decrease">−</button>
              <input class="quantity-input" type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.item_quantity' | t }}">
              <button type="button" class="quantity-btn" data-action="increase">+</button>
            </div>
          </div>

          <!-- Submit -->
          <div class="product-form__submit">
            <button
              type="submit"
              name="add"
              class="btn btn--primary btn--full"
              data-add-to-cart
              {%- unless product.selected_or_first_available_variant.available -%}disabled{%- endunless -%}
            >
              {%- if product.selected_or_first_available_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>
        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="product-info__description">{{ product.description }}</div>
        {%- endif -%}

        <!-- Meta info -->
        <div class="product-info__meta">
          {%- if product.sku != blank -%}
            <p>SKU: <span>{{ product.selected_or_first_available_variant.sku }}</span></p>
          {%- endif -%}
          {%- if product.type != blank -%}
            <p>{{ 'products.product.category' | t }}: <span>{{ product.type }}</span></p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- if section.settings.show_size_guide and section.settings.size_guide_content != blank -%}
    <div class="size-guide-modal" data-size-guide-modal aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ section.settings.size_guide_label | default: 'Guia de tamanhos' }}">
      <div class="size-guide-modal__overlay" data-size-guide-close></div>
      <div class="size-guide-modal__box">
        <button type="button" class="size-guide-modal__close" data-size-guide-close aria-label="Fechar">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <h2 class="size-guide-modal__title">{{ section.settings.size_guide_label | default: 'Guia de tamanhos' }}</h2>
        <div class="size-guide-modal__content">{{ section.settings.size_guide_content }}</div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Produto Principal",
  "tag": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "drop_badge",
      "label": "Selo acima do título",
      "default": "Limited drop",
      "info": "Deixe vazio para ocultar."
    },
    {
      "type": "header",
      "content": "Guia de tamanhos"
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "default": true,
      "label": "Mostrar guia de tamanhos"
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "default": "Guia de tamanhos",
      "label": "Texto do link"
    },
    {
      "type": "html",
      "id": "size_guide_content",
      "label": "Conteúdo (tabela de medidas)",
      "info": "Aceita HTML, incluindo tabelas. Edite os valores conforme suas peças.",
      "default": "<table><thead><tr><th>Tamanho</th><th>EU</th><th>Peito (cm)</th><th>Comprimento (cm)</th></tr></thead><tbody><tr><td>S</td><td>46</td><td>96–101</td><td>68</td></tr><tr><td>M</td><td>48–50</td><td>102–107</td><td>71</td></tr><tr><td>L</td><td>52</td><td>108–113</td><td>74</td></tr><tr><td>XL</td><td>54–56</td><td>114–119</td><td>76</td></tr></tbody></table><p>Medidas aproximadas. Na dúvida entre dois tamanhos, escolha o maior.</p>"
    }
  ]
}
{% endschema %}
