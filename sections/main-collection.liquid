{%- assign has_cover = false -%}
{%- if section.settings.show_cover_image and collection.image != blank -%}{%- assign has_cover = true -%}{%- endif -%}

<div
  class="collection-hero{% if has_cover %} collection-hero--image{% endif %}"
  {% if has_cover %}style="background-image:url({{ collection.image | image_url: width: 2200 }});min-height:{{ section.settings.cover_height }}px;--cover-overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }}"{% endif %}
>
  <div class="page-width collection-hero__inner">
    {%- if section.settings.show_eyebrow and section.settings.eyebrow_text != blank -%}
      <span class="collection-hero__eyebrow">{{ section.settings.eyebrow_text }}</span>
    {%- endif -%}
    <h1 class="collection-hero__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-hero__desc">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>

<section class="section">
  <div class="page-width">
    {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="collection-toolbar">
      <span class="collection-toolbar__count">
        {{ collection.products_count }}
        {%- if collection.products_count == 1 -%} product{%- else -%} products{%- endif -%}
      </span>
      <div class="collection-toolbar__sort">
        <label for="sort-select">Sort by:</label>
        <select id="sort-select" name="sort_by" class="sort-select" onchange="window.location.href='?sort_by='+this.value">
          <option value="manual"{% if collection.sort_by == 'manual' %} selected{% endif %}>Featured</option>
          <option value="best-selling"{% if collection.sort_by == 'best-selling' %} selected{% endif %}>Best selling</option>
          <option value="price-ascending"{% if collection.sort_by == 'price-ascending' %} selected{% endif %}>Price: low to high</option>
          <option value="price-descending"{% if collection.sort_by == 'price-descending' %} selected{% endif %}>Price: high to low</option>
          <option value="created-descending"{% if collection.sort_by == 'created-descending' %} selected{% endif %}>Newest</option>
          <option value="title-ascending"{% if collection.sort_by == 'title-ascending' %} selected{% endif %}>A-Z</option>
        </select>
      </div>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="product-grid" style="--grid-cols-desktop:{{ section.settings.columns_desktop }}">
        {%- for product in collection.products -%}
          {%- render 'card-product', product: product -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" style="display:flex;justify-content:center;gap:1rem;margin-top:5rem">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="btn btn--secondary">&lsaquo; Previous</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="btn btn--secondary">{{ part.title }}</a>
            {%- else -%}
              <span class="btn btn--primary">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="btn btn--secondary">Next &rsaquo;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p style="text-align:center;padding:6rem 0;color:rgba(var(--color-base-text),0.6)">
        No products found in this collection.
      </p>
    {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "tag": "section",
  "templates": ["collection"],
  "settings": [
    {
      "type": "header",
      "content": "Collection cover"
    },
    {
      "type": "checkbox",
      "id": "show_cover_image",
      "default": true,
      "label": "Use the collection image as a cover",
      "info": "Set the image in Products → Collections → [collection] → Image. Without an image, a clean title header is shown."
    },
    {
      "type": "range",
      "id": "cover_height",
      "min": 260,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 440,
      "label": "Cover height"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45,
      "label": "Image darkening"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "default": true,
      "label": "Show eyebrow label"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "default": "// Collection",
      "label": "Eyebrow text"
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
