      { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "placeholder": "612345678", "info": "Local number only (without the country code)." },
      { "type": "checkbox", "id": "whatsapp_show_desktop", "label": "Show on desktop", "default": true },
      { "type": "checkbox", "id": "whatsapp_show_mobile", "label": "Show on mobile", "default": true }
    ]
  },
  {
