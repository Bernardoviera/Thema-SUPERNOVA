  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "type_header_font", "default": "archivo_n7", "label": "Heading font" },
      { "type": "font_picker", "id": "type_body_font", "default": "inter_n4", "label": "Body font" },
      { "type": "range", "id": "body_scale", "min": 100, "max": 130, "step": 5, "unit": "%", "label": "Body font size", "default": 100 },
      { "type": "range", "id": "heading_scale", "min": 100, "max": 150, "step": 5, "unit": "%", "label": "Heading font size", "default": 120 }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select", "id": "page_width",
        "options": [
          { "value": "1200", "label": "1200px" },
          { "value": "1400", "label": "1400px" },
          { "value": "1600", "label": "1600px" }
        ],
        "default": "1400", "label": "Maximum page width"
      },
      { "type": "range", "id": "spacing_sections", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Spacing between sections", "default": 60 },
      { "type": "range", "id": "spacing_grid_horizontal", "min": 4, "max": 40, "step": 4, "unit": "px", "label": "Grid horizontal spacing", "default": 24 },
      { "type": "range", "id": "spacing_grid_vertical", "min": 4, "max": 60, "step": 4, "unit": "px", "label": "Grid vertical spacing", "default": 36 }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select", "id": "cart_type",
