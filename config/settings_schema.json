    "theme_documentation_url": "https://supernova.eu",
    "theme_support_url": "https://supernova.eu"
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "header", "content": "Content (light areas)" },
      { "type": "color", "id": "colors_text", "default": "#0b0b0f", "label": "Body text" },
      { "type": "color", "id": "colors_background_1", "default": "#ffffff", "label": "Background" },
      { "type": "color", "id": "colors_background_2", "default": "#f4f4f5", "label": "Secondary background" },
      { "type": "header", "content": "Accents" },
      { "type": "color", "id": "colors_accent_1", "default": "#5b4dff", "label": "Electric accent" },
      { "type": "color", "id": "colors_accent_2", "default": "#0b0b0f", "label": "Accent 2" },
      { "type": "color", "id": "colors_solid_button_labels", "default": "#ffffff", "label": "Solid button text" },
      { "type": "color", "id": "colors_outline_button_labels", "default": "#0b0b0f", "label": "Outline button text" },
      { "type": "header", "content": "Brand surfaces (dark areas: header, footer, banners)" },
      { "type": "color", "id": "colors_brand_surface", "default": "#0b0b0f", "label": "Brand surface background" },
      { "type": "color", "id": "colors_brand_surface_text", "default": "#f5f5f7", "label": "Brand surface text" },
      { "type": "header", "content": "Gradients (optional)" },
      { "type": "color_background", "id": "gradient_background_1", "label": "Background gradient" },
      { "type": "color_background", "id": "gradient_background_2", "label": "Secondary background gradient" },
      { "type": "color_background", "id": "gradient_accent_1", "label": "Accent 1 gradient" },
      { "type": "color_background", "id": "gradient_accent_2", "label": "Accent 2 gradient" }
