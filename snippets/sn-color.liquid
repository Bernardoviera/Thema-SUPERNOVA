{%- comment -%}
  Resolve a colour name to a hex value. Returns the hex (or nothing if unknown).
  Usage: {%- capture hex -%}{%- render 'sn-color', name: 'cream' -%}{%- endcapture -%}
  Keys are normalised (lowercase, no spaces/hyphens), so "Off White" == "off-white".
{%- endcomment -%}
{%- assign n = name | strip | downcase | replace: ' ', '' | replace: '-', '' | replace: '_', '' -%}
{%- assign map = 'black:#111111,jetblack:#0a0a0a,white:#ffffff,offwhite:#f5f1e8,cream:#f3ead3,ivory:#fffdf0,vanilla:#f3e5ab,beige:#e8d8b9,nude:#e3bc9a,tan:#d2b48c,camel:#c19a6b,khaki:#c3b091,sand:#c2b280,taupe:#b8a99a,stone:#b3a394,bone:#e3dac9,oatmeal:#e0d6c2,brown:#6b4423,chocolate:#4e342e,coffee:#6f4e37,grey:#808080,gray:#808080,lightgrey:#c8c8c8,lightgray:#c8c8c8,darkgrey:#4a4a4a,darkgray:#4a4a4a,charcoal:#36454f,slate:#5a6470,silver:#c0c0c0,navy:#1f2a44,blue:#2b50aa,royalblue:#2740c4,cobalt:#21409a,denim:#3b5a86,skyblue:#7db9e8,lightblue:#9ec9e8,babyblue:#bcd4e6,teal:#008080,petrol:#1b4d4d,turquoise:#30d5c8,aqua:#22d3ee,cyan:#00bcd4,green:#2e7d32,forest:#1f4d2e,forestgreen:#1f4d2e,emerald:#0f8a5f,olive:#708238,army:#4b5320,military:#4b5320,khakigreen:#728639,sage:#9caf88,mint:#9fe2bf,lime:#9acd32,neongreen:#39ff14,yellow:#f4c430,mustard:#d4a017,gold:#d4af37,amber:#ffbf00,orange:#e8772e,rust:#b7410e,terracotta:#c45c3a,peach:#ffcba4,apricot:#fbceb1,coral:#ff7f50,salmon:#fa8072,red:#d12631,crimson:#b81d24,cherry:#a30b37,maroon:#800000,burgundy:#6d071a,wine:#722f37,oxblood:#4a0d10,pink:#ff6fa5,hotpink:#ff4d94,babypink:#f7c5d8,rose:#c9637c,blush:#de98a4,fuchsia:#c724b1,magenta:#c724b1,purple:#6a0dad,plum:#6c2a52,violet:#7f3fbf,lilac:#c8a2c8,lavender:#b497bd,indigo:#4b0082,multicolor:#9b59b6,multicolour:#9b59b6' | split: ',' -%}
{%- for pair in map -%}
  {%- assign kv = pair | split: ':' -%}
  {%- if kv[0] == n -%}{{ kv[1] }}{%- break -%}{%- endif -%}
{%- endfor -%}
