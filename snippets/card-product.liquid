{%- comment -%}
  Renders a product card.
  Accepts:
  - product: {Object} Product Liquid object
  - lazy_load: {Boolean} Image should be lazy loaded
{%- endcomment -%}

{%- liquid
  assign lazy_load = lazy_load | default: true
  assign first_available_variant = product.first_available_variant
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<div class="product-card">
  <div class="product-card__media">
    <a href="{{ product.url }}" class="product-card__media-link" aria-label="{{ product.title | escape }}">
      {%- if product.featured_image != blank -%}
        {{
          product.featured_image
          | image_url: width: 600
          | image_tag:
            loading: lazy_load,
            width: 600,
            alt: product.title,
            class: 'product-card__img'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      <span class="product-card__scan" aria-hidden="true"></span>
    </a>

    <div class="product-card__badges">
      {%- if on_sale -%}
        <span class="badge badge--sale">Sale</span>
      {%- endif -%}
      {%- if product.tags contains 'new' or product.tags contains 'novo' -%}
        <span class="badge badge--new">New</span>
      {%- endif -%}
    </div>
  </div>

  <div class="product-card__info">
    {%- if index != blank -%}
      {%- capture idx -%}00{{ index }}{%- endcapture -%}
      <div class="product-card__index">{{ idx | slice: -3, 3 }} <span>//</span></div>
    {%- endif -%}

    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="price">
      {%- render 'price', product: product -%}
    </div>
  </div>

  {%- if first_available_variant != blank -%}
    <button
      class="product-card__add"
      data-quick-add="{{ first_available_variant.id }}"
      aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title }}"
    >
      <span>Add to cart</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </button>
  {%- endif -%}
</div>
